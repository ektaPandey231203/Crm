<?php
// Database connection
$host = "localhost";
$user = "root";
$pass = "";
$dbname = "ticket_db";

$conn = new mysqli($host, $user, $pass, $dbname);

// Check connection
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

// If form submitted
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $name = $_POST['name'];
    $issue = $_POST['issue'];
    $priority = $_POST['priority'];

    // Insert using Prepared Statement
    $stmt = $conn->prepare("INSERT INTO tickets (name, issue, priority) VALUES (?, ?, ?)");
    $stmt->bind_param("sss", $name, $issue, $priority);

    if ($stmt->execute()) {
        echo "<p style='color:green;'>Ticket Registered Successfully!</p>";
    } else {
        echo "<p style='color:red;'>Error: " . $stmt->error . "</p>";
    }

    $stmt->close();
}

// Fetch tickets for register
$result = $conn->query("SELECT id, name, issue, priority, created_at FROM tickets ORDER BY id DESC");
?>

